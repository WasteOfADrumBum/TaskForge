MONGO_URI=mongodb://localhost:27017/taskforge
JWT_SECRET=replace-with-a-secure-random-secret
PORT=5000
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=replace-with-a-demo-password
CLIENT_ORIGIN=http://localhost:5173

# No model calls by default. Demo requires explicit selection by a caller.
AI_PROVIDER=disabled
# Local development only: set AI_PROVIDER=ollama explicitly after installing a local model.
# Production ignores local inference configuration and remains disabled.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional explicit local embeddings only; manually install the pinned manifest before enabling.
# No automatic pulls; production remains disabled. Only this exact model/digest is accepted.
OLLAMA_EMBEDDING_MODEL=
# OLLAMA_EMBEDDING_MODEL=all-minilm:l6-v2
