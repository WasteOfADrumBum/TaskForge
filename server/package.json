{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --trace-warnings --loader ts-node/esm ./src/server.ts",
    "build": "tsc --noEmit && tsup src/server.ts --format esm --platform node --out-dir dist/server --clean",
    "start": "node dist/server/server.js",
    "test": "jest",
    "lint": "eslint src",
    "format": "prettier --write src",
    "seed:demo": "node --loader ts-node/esm ./src/scripts/seedDemo.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.13.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.24.0",
    "jest": "^30.5.2",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}
