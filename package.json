{
  "name": "taskforge",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "test": "jest",
    "test:client": "npm --workspace client run test",
    "test:server": "npm --workspace server run test"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "jest": "^29.7.0",
    "typescript": "^5.8.3",
    "@types/node": "^22.14.0",
    "ts-node": "^10.9.2"
  }
}
